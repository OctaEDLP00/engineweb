{
  "compilerOptions": {
    "types": ["node"],
    "lib": ["ESNext", "DOM", "DOM.Iterable", "WebWorker"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "moduleResolution": "bundler",
    "module": "ESNext",
    "target": "ESNext",
    "paths": {
      "@engineweb/*": ["./packages/*/src"]
    }
  },
  "exclude": ["node_modules", "dist", "build", "docs"]
}
