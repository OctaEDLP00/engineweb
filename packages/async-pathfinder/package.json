{
  "name": "@engineweb/async-pathfinder",
  "version": "0.0.2",
  "description": "Fragmented A* / Theta* pathfinding that yields across frames with generators",
  "keywords": ["pathfinding", "a-star", "theta-star", "navmesh", "bezier", "async"],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "src", "README.md", "CHANGELOG.md", "LICENSE"],
  "scripts": {
    "build": "tsdown index.ts --format esm --dts --clean --no-fixed-extension",
    "test": "vitest run --passWithNoTests",
    "coverage": "vitest run --coverage --passWithNoTests"
  },
  "license": "MIT",
  "repository": {
    "directory": "packages/async-pathfinder",
    "type": "git",
    "url": "https://github.com/OctaEDLP00/engineweb.git"
