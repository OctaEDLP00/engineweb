{
  "name": "@engineweb/effect-asset-pipeline",
  "version": "0.0.2",
  "description": "Resilient asset loader and GPU cache manager powered by Effect (Streams, retries, LRU)",
  "keywords": ["assets", "loader", "effect", "streams", "retry", "lru", "cache"],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "src", "README.md", "CHANGELOG.md", "LICENSE"],
  "scripts": {
    "build": "tsdown index.ts --format esm --dts --clean --no-fixed-extension",
    "test": "vitest run --passWithNoTests",
    "coverage": "vitest run --coverage --passWithNoTests"
  },
  "dependencies": {
    "effect": "^4.0.6"
  },
  "license": "MIT",
  "repository": {
    "directory": "packages/effect-asset-pipeline",
    "type": "git",
    "url": "https://github.com/OctaEDLP00/engineweb.git"
  },
  "bugs": "https://github.com/OctaEDLP00/engineweb/issues",
  "homepage": "https://github.com/OctaEDLP00/engineweb#readme"
}
