{
  "name": "@engineweb/skeletal-gpu",
  "version": "0.0.2",
  "description": "GPU-accelerated skeletal animation & skinning via WebGPU/WebGL2 compute and storage buffers",
  "keywords": ["skeletal-animation", "skinning", "webgpu", "webgl2", "blend-shapes", "quaternion"],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "src", "README.md", "CHANGELOG.md", "LICENSE"],
  "scripts": {
    "build": "tsdown index.ts --format esm --dts --clean --no-fixed-extension",
    "test": "vitest run --passWithNoTests",
    "coverage": "vitest run --coverage --passWithNoTests"
  },
  "license": "MIT",
  "repository": {
    "directory": "packages/skeletal-gpu",
    "type": "git",
    "url": "https://github.com/OctaEDLP00/engineweb.git"
  },
  "bugs": "https://github.com/OctaEDLP00/engineweb/issues",
  "homepage": "https://github.com/OctaEDLP00/engineweb#readme"
}
